---
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import MonsterLibrary from "../../../components/MonsterLibrary.astro";
import MonsterBook from "../../../components/MonsterBook.astro";
import monsters from "../../../data/monsters.json";
import { breadcrumb } from "../../../lib/schema";
import headerMonster from "../../../assets/monsters-header.png";

const title = "The Monster Book";
const description =
  "Free printable coloring pages: hand-drawn ink monsters, black on white, sized to a full sheet of Letter or A4. Download one, print five at random, or color one in the browser.";

const jsonLd = [
  {
    "@type": "CreativeWork",
    name: title,
    description:
      "A growing set of hand-drawn ink monsters released as free printable coloring pages, with an in-browser coloring canvas.",
    creator: { "@id": "https://jakeherridge.com/#person" },
    url: "https://jakeherridge.com/exhibits/monsters/",
    isAccessibleForFree: true,
    // The sheets are the point of the room, so they are in the graph too.
    hasPart: monsters.map((m) => ({
      "@type": "CreativeWork",
      name: m.title,
      encodingFormat: "application/pdf",
      url: `https://jakeherridge.com/monsters/print/${m.id}-letter.pdf`,
    })),
  },
  breadcrumb([
    { name: "Exhibits", url: "https://jakeherridge.com/exhibits/" },
    { name: title, url: "https://jakeherridge.com/exhibits/monsters/" },
  ]),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-5xl px-5 py-14">
    <header class="grid items-center gap-8 md:grid-cols-[7fr_5fr]">
      <div>
        <p class="font-mono text-[0.65rem] uppercase tracking-widest text-rust">
          Exhibit · Coloring pages
        </p>
        <h1 class="wonk mt-2 text-4xl font-semibold tracking-tight md:text-6xl">{title}</h1>
        <p class="mt-4 font-mono text-xs tracking-wide text-muted">
          {monsters.length} pages · ink on paper, drawn by hand · free to print
        </p>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          Monsters drawn by hand in ink, scanned at print resolution, and set on a
          full sheet of paper. Take any of them. They are meant for a kid, a
          printer, and a box of crayons. New ones get added as they are drawn.
        </p>
        <p class="mt-3 text-sm text-muted">
          You can also color one here, in the browser. That is the smaller half of
          this room.
        </p>
      </div>
      <Image
        src={headerMonster}
        alt="A colored page from the book: a blue four-eyed monster with gold tusks, orange claws, and pink paw pads"
        widths={[420, 640, 900]}
        sizes="(max-width: 768px) 82vw, 380px"
        format="webp"
        class="mx-auto w-full max-w-[300px] -rotate-1 rounded-md border border-faint shadow-sm md:mx-0 md:max-w-none"
      />
    </header>

    <MonsterLibrary />

    <section id="color-one" class="mt-20 scroll-mt-8">
      <h2 class="wonk text-2xl font-semibold tracking-tight md:text-3xl">Color one here</h2>
      <p class="mt-3 max-w-2xl text-muted">
        The same monsters, on screen. Pick a color from the book's palette and
        click inside a monster. The monsters take color. The paper around them is
        locked.
      </p>
      <div class="mt-8">
        <MonsterBook />
      </div>
    </section>
  </article>
</BaseLayout>

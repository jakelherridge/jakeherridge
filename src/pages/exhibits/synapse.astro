---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SynapseBench from "../../components/SynapseBench.astro";
import { breadcrumb } from "../../lib/schema";
import vault from "../../../public/synapse/vault.json";

const title = "Synapse";
const description = `Synapse instantly connects all of your files for AI context. A Claude Code plugin that turns a folder of notes into a typed, tagged, connected graph an AI can read. This one is Jake's own, with ${vault.n} nodes and three tests you can run.`;

const jsonLd = [
  {
    "@type": "CreativeWork",
    name: title,
    description:
      "A personal knowledge graph of typed nodes and typed edges, shown as a specimen brain wired to a reading rig. The whole vault appears as anonymous points; the allowlisted nodes carry names.",
    creator: { "@id": "https://jakeherridge.com/#person" },
    url: "https://jakeherridge.com/exhibits/synapse/",
  },
  breadcrumb([
    { name: "Jake Herridge", url: "https://jakeherridge.com/" },
    { name: title, url: "https://jakeherridge.com/exhibits/synapse/" },
  ]),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-5xl px-5 py-14">
    <header>
      <h1 class="wonk text-4xl font-semibold tracking-tight md:text-6xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
        Instantly connects all of your files.
      </p>
      <p class="mt-5 max-w-2xl leading-relaxed text-ink">
        Synapse is a
        <a
          href="https://github.com/jakelherridge/synapse-capture"
          rel="noopener"
          class="text-accent-strong underline underline-offset-4 hover:text-accent"
          >Claude Code plugin</a
        > and the graph it builds. Point it at a folder of notes and it breaks what
        it finds into small typed nodes, tags them, and connects them with typed
        edges. An AI can then read that graph and pick up your context instantly,
        built from everything you have fed it and found important.
      </p>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
        This one is mine, as the example. The three scraps under the brain are
        tests: feed one in and watch it tag and connect for real.
      </p>
    </header>

    <div class="mt-10">
      <SynapseBench />
    </div>

    <footer class="mt-12 border-t border-faint pt-6">
      <a href="/map/" class="text-accent underline underline-offset-4 hover:text-accent-strong">
        The Map is the same idea, turned on its author &rarr;
      </a>
    </footer>
  </article>
</BaseLayout>

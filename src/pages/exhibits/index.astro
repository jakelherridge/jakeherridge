---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { exhibits } from "../../data/exhibits";
---

<BaseLayout
  title="Exhibits"
  description="Exhibit rooms for Jake Herridge's favorite projects: the PocketWild field journal and the Glitchy Gator Club. More rooms open through the month."
>
  <section class="mx-auto max-w-5xl px-5 py-14">
    <h1 class="wonk text-4xl font-semibold tracking-tight md:text-5xl">Exhibits</h1>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        exhibits.map((e) => (
          <a href={e.href} class="poster group reveal">
            <div class="overflow-hidden rounded-md border border-faint">
              <Image
                src={e.image}
                alt={e.alt}
                widths={[480, 720, 960]}
                sizes="(max-width: 640px) 92vw, 480px"
                format="webp"
                class:list={[
                  "aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]",
                  e.pixelated && "pixelated",
                ]}
              />
            </div>
            <p class="mt-3 font-mono text-[0.65rem] uppercase tracking-widest text-rust">
              {e.label}
            </p>
            <h2 class="wonk mt-1 text-2xl font-semibold tracking-tight transition-colors group-hover:text-accent">
              {e.title}
            </h2>
            <p class="mt-1 text-sm text-muted">{e.line}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

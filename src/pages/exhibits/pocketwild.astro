---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PocketwildExhibit from "../../components/PocketwildExhibit.astro";
import { breadcrumb } from "../../lib/schema";

const title = "PocketWild";
const description =
  "Notice and name the real world. The PocketWild field journal in the browser: log captures from the 228-species index, name them, fill your meadow. Narrated by Aldo.";

const jsonLd = [
  {
    "@type": "SoftwareApplication",
    name: "PocketWild",
    applicationCategory: "LifestyleApplication",
    operatingSystem: "iOS",
    url: "https://www.pocketwild.app/",
    author: { "@id": "https://jakeherridge.com/#person" },
    description:
      "A native iOS field journal: photograph creatures and plants, keep a private local collection, narrated by Aldo the frog.",
  },
  breadcrumb([
    { name: "Jake Herridge", url: "https://jakeherridge.com/" },
    { name: title, url: "https://jakeherridge.com/exhibits/pocketwild/" },
  ]),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-5xl px-5 py-14">
    <header class="max-w-2xl">
      <p class="font-mono text-[0.65rem] uppercase tracking-widest text-rust">
        Exhibit · iOS app
      </p>
      <h1 class="wonk mt-2 text-4xl font-semibold tracking-tight md:text-6xl">{title}</h1>
      <p class="mt-4 font-mono text-xs tracking-wide text-muted">
        228 species · AI-curated pixel sprites · entries stamped with weather and moon phase ·
        no accounts, no feed, no ads
      </p>
      <p class="mt-5 text-lg leading-relaxed text-muted">Notice and name the real world.</p>
      <a
        href="https://www.pocketwild.app/"
        rel="noopener"
        class="group mt-6 flex items-center justify-between gap-4 rounded-lg border-2 border-accent bg-accent-soft px-5 py-4 no-underline transition-colors hover:bg-accent hover:text-paper"
      >
        <span>
          <span class="wonk block text-xl font-semibold tracking-tight md:text-2xl">
            Get PocketWild
          </span>
          <span class="mt-0.5 block text-sm text-muted transition-colors group-hover:text-paper/80">
            pocketwild.app · the real app, on your phone
          </span>
        </span>
        <span
          aria-hidden="true"
          class="text-2xl text-accent transition-all group-hover:translate-x-1 group-hover:text-paper"
        >
          &rarr;
        </span>
      </a>
      <p class="mt-4 font-serif text-lg italic leading-relaxed text-ink">
        The narrator is Aldo. He is a frog, named for Aldo Leopold, and he has been here a long
        time. From here on, he does the talking.
      </p>
    </header>

    <div class="mt-10">
      <PocketwildExhibit />
    </div>

    <footer class="mt-12 border-t border-faint pt-6">
      <a
        href="https://www.pocketwild.app/"
        rel="noopener"
        class="text-accent underline underline-offset-4 hover:text-accent-strong"
      >
        The real thing lives at pocketwild.app &rarr;
      </a>
    </footer>
  </article>
</BaseLayout>

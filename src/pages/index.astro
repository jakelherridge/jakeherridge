---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { exhibits } from "../data/exhibits";
import professional from "../assets/jake-professional.jpg";
import candid from "../assets/jake-candid.jpg";

const name = "Jake Herridge";
let letterIndex = 0;
const words = name.split(" ").map((word) => word.split("").map((ch) => ({ ch, i: letterIndex++ })));
---

<BaseLayout
  title="Jake Herridge"
  description="Jake Herridge. A gator machine, monster sketches, an iOS field journal, a short story, and my wife's kitchen. Start anywhere, or take the map."
>
  <!-- The front door: a name, a welcome, and the two Jakes. -->
  <section class="mx-auto max-w-5xl px-5 pt-16 md:pt-24">
    <div class="grid items-center gap-10 md:grid-cols-[7fr_5fr]">
      <div>
        <h1
          class="wonk kinetic text-5xl font-semibold leading-[1.03] tracking-tight md:text-7xl"
          aria-label={name}
        >
          {
            words.map((letters, w) => (
              <>
                {w > 0 && " "}
                <span class="inline-block whitespace-nowrap" aria-hidden="true">
                  {letters.map(({ ch, i }) => (
                    <span class="kl" style={`--i:${i}`}>{ch}</span>
                  ))}
                </span>
              </>
            ))
          }
        </h1>
        <p
          class="enter mt-4 font-serif text-2xl italic text-muted md:text-3xl"
          style="--enter-step: 4"
        >
          Welcome.
        </p>
      </div>
      {/* Two photos, polished and real. They drift with the stickers. */}
      <div
        class="enter drift relative mx-auto w-full max-w-[280px] md:mx-0 md:max-w-none"
        style="--enter-step: 3; --dur: 26s"
      >
        <Image
          src={professional}
          alt="Jake Herridge"
          widths={[360, 540, 720]}
          sizes="(max-width: 768px) 280px, 360px"
          format="webp"
          class="w-full rounded-md border border-faint object-cover shadow-sm"
        />
        <Image
          src={candid}
          alt="Jake Herridge outdoors"
          widths={[200, 320]}
          sizes="150px"
          format="webp"
          class="absolute -bottom-5 -left-5 w-[42%] -rotate-2 rounded-md border-4 border-paper object-cover shadow-md"
        />
      </div>
    </div>
  </section>

  <!-- The sticker wall. Each exhibit is a die-cut sticker; click one to go in. -->
  <section class="mx-auto max-w-5xl px-5 pb-10 pt-14 md:pt-20" aria-label="Exhibits">
    <ul class="sticker-wall">
      {
        exhibits.map((e, i) => (
          <li
            class="sticker-spot drift"
            style={`--tilt: ${[-2.4, 1.8, -1.5, 2.6, -2, 1.6][i % 6]}deg; --dur: ${[19, 23, 17, 25, 21, 27][i % 6]}s; --phase: ${[-3, -9, -14, -6, -11, -17][i % 6]}s; --dir: ${i % 2 ? "reverse" : "normal"}`}
          >
            <a
              href={e.href}
              class="sticker group"
              rel={e.external ? "noopener" : undefined}
              target={e.external ? "_blank" : undefined}
            >
              {/* webp keeps the die-cut alpha and carries the photo card at a
                  fraction of PNG weight. */}
              <Image
                src={e.sticker}
                alt={e.alt}
                widths={[320, 480, 640]}
                sizes="(max-width: 640px) 44vw, 300px"
                format="webp"
                class="sticker-img"
              />
              <span class="mt-3 block">
                <span class="wonk block text-xl font-semibold tracking-tight transition-colors group-hover:text-accent md:text-2xl">
                  {e.title}
                </span>
                <span class="mt-0.5 block text-sm text-muted">{e.line}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- The other door. -->
  <section class="mx-auto max-w-5xl px-5 pb-24">
    <a
      href="/map/"
      class="group inline-flex items-baseline gap-2 font-serif text-lg text-muted transition-colors hover:text-accent"
    >
      Or take a look at the map, where everything connects
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
    </a>
  </section>
</BaseLayout>

<style>
  .sticker-wall {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
  }
  @media (min-width: 768px) {
    .sticker-wall {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3.5rem 2rem;
    }
  }
  .sticker-spot {
    display: flex;
    justify-content: center;
  }
  .sticker {
    display: block;
    max-width: 300px;
    text-align: center;
    text-decoration: none;
    color: inherit;
  }
  /* The sticker sits slightly askew and peels toward you on hover. The drop
     shadow lives on the image's alpha, so it hugs the die-cut edge instead of
     boxing the PNG. */
  .sticker-img {
    width: 100%;
    height: auto;
    transform: rotate(var(--tilt));
    filter: drop-shadow(0 2px 3px rgb(27 26 23 / 0.18));
    transition:
      transform 0.22s ease,
      filter 0.22s ease;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sticker:hover .sticker-img,
    .sticker:focus-visible .sticker-img {
      transform: rotate(0deg) scale(1.045);
      filter: drop-shadow(0 10px 18px rgb(27 26 23 / 0.24));
    }
  }
  .sticker:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
    border-radius: 8px;
  }

  /* Everything on the page is adrift: each sticker and the photos trace a
     slow small orbit, all on different clocks so nothing looks synchronized.
     The orbit lives on the wrapper, so hover transforms underneath still
     work, and it stops entirely for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .drift {
      animation: orbit var(--dur, 22s) ease-in-out infinite var(--dir, normal);
      animation-delay: var(--phase, 0s);
    }
  }
  @keyframes orbit {
    0%,
    100% {
      transform: translate(0px, 0px);
    }
    25% {
      transform: translate(5px, -7px);
    }
    50% {
      transform: translate(0px, -12px);
    }
    75% {
      transform: translate(-5px, -6px);
    }
  }
</style>

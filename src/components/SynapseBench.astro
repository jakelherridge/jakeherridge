---
// The Synapse bench, v2. The brain on the left with a tray of raw scraps
// under it, wires to the reading rig, and below the whole scene a full-width
// projection: the vault as a big labeled 3D graph.
//
// Two interactions, both real data:
//   FEED — click a scrap and watch the room replay how that node actually
//   entered the vault: the dot is born, its real tags stamp on, its real
//   typed edges shoot to their neighbors. This is the plugin's pitch: point
//   synapse-capture at a folder and it types, tags, and connects everything
//   on its own.
//   ASK — four keys on the rig, each a question about this website. The
//   what-is-Synapse answer's short form lives in the page header; the SYNAPSE
//   key gives the full cited version. Traces tick on the rig's strip, hops
//   caption on the projection, answers land on paper with citations that open
//   real node cards.
//
// The rig is Jake's rendered console; CRT, strip, and keys are live regions
// over it (measured percentages, same as the gator machine). Wires are
// runtime SVG so pulses ride them and the bench restacks on phones.
import { Image } from "astro:assets";
import brainImg from "../assets/synapse-brain.png";
import rigImg from "../assets/synapse-rig.png";
import vault from "../../public/synapse/vault.json";
import nodesData from "../../public/synapse/nodes.json";
import { demos, feedIds } from "../data/synapse-demo";

// Live regions, measured off the trimmed 639x733 render.
const CRT = { x: 21.6, y: 14.7, w: 57.9, h: 38.9 };
const STRIP = { x: 25.5, y: 63.4, w: 50.9, h: 8.5 };
const KEYS = [26.9, 35.7, 44.6, 53.5];
const KEY = { cy: 84.3, d: 9.4 };
// Knobs sit 8.8% apart, so plates must stay narrower than that.
const PLATE = { y: 90.2, w: 8.2, h: 3.2 };

// Which named dots each demo's trace visits, derived from the step text so
// the projection walks exactly what the trace says.
const namedSlugs = Object.keys(vault.named);
const demoPayload = demos.map((d) => {
  const seen = new Set();
  const path = [];
  for (const s of d.steps) {
    for (const slug of namedSlugs) {
      if (!seen.has(slug) && s.text.includes(slug)) {
        seen.add(slug);
        path.push(slug);
      }
    }
  }
  return { id: d.id, q: d.q, steps: d.steps, answerHtml: d.answerHtml, path };
});

// The feed replays, straight from the exported nodes: provenance becomes the
// scrap, tags and typed edges are the node's own frontmatter.
const byId = Object.fromEntries(nodesData.nodes.map((n) => [n.id, n]));
const feeds = feedIds
  .filter((id) => byId[id])
  .map((id) => {
    const n = byId[id];
    const file = String(n.provenance || "").split(";")[0].trim();
    const edges = [];
    let locked = 0;
    for (const [rel, targets] of Object.entries(n.edges || {})) {
      if (rel.endsWith("_locked")) {
        locked += targets;
        continue;
      }
      for (const t of targets) {
        if (t in vault.named) edges.push({ rel, target: t });
      }
    }
    return { slug: id, title: n.title, kind: n.kind, file, tags: n.tags || [], edges, locked };
  });

const stats = { n: vault.n, e: vault.e, v: vault.v, d: vault.d, named: namedSlugs.length };
---

<section class="syb" data-bench>
  <div class="syb-scene" data-scene>
    <div class="syb-left">
      <figure class="syb-brain" data-brain>
        <Image
          src={brainImg}
          alt="A coral-pink brain drawn as a network of connected nodes"
          widths={[380, 560, 749]}
          sizes="(max-width: 900px) 230px, 320px"
          format="png"
          loading="eager"
        />
      </figure>
      <div class="syb-tray" aria-label="Raw scraps to feed the brain">
        <p class="syb-tray-label">Raw · feed it a scrap</p>
        {
          feeds.map((f) => (
            <button type="button" class="syb-scrap" data-feed={f.slug} title={`Replay how ${f.title} entered the vault`}>
              <span class="syb-scrap-file">{f.file}</span>
              <span class="syb-scrap-kind">{f.kind} · {f.tags.length} tags · {f.edges.length + f.locked} links</span>
            </button>
          ))
        }
      </div>
    </div>

    <svg class="syb-wires" data-wires aria-hidden="true"></svg>

    <div class="syb-rig" data-rig>
      <Image
        src={rigImg}
        alt=""
        widths={[420, 639]}
        sizes="(max-width: 900px) 88vw, 430px"
        format="png"
        loading="eager"
        class="syb-rig-img"
      />
      <div class="syb-crt" style={`left:${CRT.x}%;top:${CRT.y}%;width:${CRT.w}%;height:${CRT.h}%`}>
        <canvas data-mini aria-hidden="true"></canvas>
      </div>
      <div
        class="syb-strip"
        style={`left:${STRIP.x}%;top:${STRIP.y}%;width:${STRIP.w}%;height:${STRIP.h}%`}
      >
        <span data-strip-text></span>
      </div>
      {
        demoPayload.map((d, i) => (
          <button
            type="button"
            class="syb-key"
            data-key={d.id}
            aria-label={d.q}
            title={d.q}
            style={`left:${KEYS[i] - KEY.d / 2}%;top:${KEY.cy - (KEY.d * (639 / 733)) / 2}%;width:${KEY.d}%`}
          />
        ))
      }
      {
        demos.map((d, i) => (
          <span
            class="syb-plate"
            aria-hidden="true"
            style={`left:${KEYS[i] - PLATE.w / 2}%;top:${PLATE.y}%;width:${PLATE.w}%;height:${PLATE.h}%`}
          >
            {d.key}
          </span>
        ))
      }
    </div>
  </div>

  <!-- The projection: what the rig sees, at reading size -->
  <div class="syb-projection">
    <p class="syb-proj-title" aria-hidden="true">
      THE VAULT · {stats.n} NODES · {stats.e} EDGES
    </p>
    <canvas
      data-proj
      aria-label={`The whole Synapse vault as a slowly turning labeled 3D graph. ${stats.named} named nodes can be opened; the rest stay anonymous.`}
    ></canvas>
    <p class="syb-caption" data-caption aria-live="polite"></p>
  </div>

  <p class="syb-hint">
    Feed it a scrap and watch the node get made, or press a key on the rig to
    ask. Bright dots open; dim dots are real files that stay anonymous.
  </p>

  <div class="syb-answer" data-answer hidden>
    <p class="syb-q" data-q></p>
    <div class="syb-a" data-a></div>
  </div>

  <aside class="syb-card" data-card hidden aria-live="polite"></aside>

  <p class="syb-label">
    {stats.n.toLocaleString("en-US")} nodes · {stats.e.toLocaleString("en-US")} typed
    edges · {stats.v} verified · exported {stats.d}. The shape is the whole vault;
    the {stats.named} named nodes are the public part. Built by
    <a href="https://github.com/jakelherridge/synapse-capture" rel="noopener"
      >synapse-capture</a
    >, a Claude Code plugin.
  </p>

  <script
    type="application/json"
    data-syb-data
    set:html={JSON.stringify({ vault, demos: demoPayload, feeds })}
  />
</section>

<style is:global>
  /* Global on purpose: cards, cites, and reel content are injected at
     runtime, and scoped selectors would not match them. */
  .syb-scene {
    position: relative;
    display: grid;
    grid-template-columns: 4fr 6fr;
    align-items: center;
    gap: clamp(1rem, 5vw, 3.5rem);
  }
  @media (max-width: 899px) {
    .syb-scene {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 3rem;
    }
  }
  .syb-left {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    align-items: center;
  }
  .syb-brain {
    margin: 0;
    max-width: 320px;
  }
  @media (max-width: 899px) {
    .syb-brain {
      max-width: 230px;
    }
  }
  .syb-brain img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 10px 22px rgb(27 26 23 / 0.18));
  }
  @media (prefers-reduced-motion: no-preference) {
    .syb-brain {
      animation: syb-breathe 5.5s ease-in-out infinite;
    }
  }
  @keyframes syb-breathe {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-6px) scale(1.012);
    }
  }

  .syb-tray {
    width: 100%;
    max-width: 300px;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .syb-tray-label {
    margin: 0 0 0.1rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .syb-scrap {
    text-align: left;
    border: 1px solid var(--color-faint);
    border-radius: 7px;
    background: var(--color-surface);
    padding: 0.5rem 0.7rem;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .syb-scrap:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px) rotate(-0.4deg);
    box-shadow: 0 6px 14px rgb(27 26 23 / 0.1);
  }
  .syb-scrap:disabled {
    opacity: 0.55;
    cursor: default;
    transform: none;
  }
  .syb-scrap-file {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--color-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .syb-scrap-kind {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .syb-wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
    z-index: 1;
  }
  .syb-wires path {
    fill: none;
    stroke: #1b1a17;
    stroke-width: 2.4;
    stroke-linecap: round;
    opacity: 0.75;
    transition: stroke 0.3s ease, opacity 0.3s ease;
  }
  .syb-wires.firing path {
    stroke: #1f6b54;
    opacity: 1;
  }
  .syb-wires circle {
    fill: #7ce8b6;
  }

  .syb-rig {
    position: relative;
    width: min(88vw, 430px);
  }
  .syb-rig-img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 16px 28px rgb(27 26 23 / 0.2));
  }
  .syb-crt {
    position: absolute;
    overflow: hidden;
    border-radius: 7% / 9%;
    background: #0d1210;
  }
  .syb-crt canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .syb-strip {
    position: absolute;
    display: flex;
    align-items: center;
    padding: 0 3%;
    background: #262a20;
    border-radius: 4px;
    box-shadow: inset 0 2px 6px rgb(0 0 0 / 0.55);
    overflow: hidden;
  }
  .syb-strip span {
    font-family: var(--font-mono);
    font-size: clamp(0.42rem, 1.5vw, 0.6rem);
    letter-spacing: 0.05em;
    white-space: nowrap;
    color: #cfe3bf;
    text-shadow: 0 0 6px rgb(160 220 150 / 0.35);
  }
  .syb-key {
    position: absolute;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 0;
    background: radial-gradient(circle at 36% 30%, rgb(255 255 255 / 0.18), transparent 55%);
    cursor: pointer;
    transition: box-shadow 0.15s ease, transform 0.1s ease;
  }
  .syb-key:hover {
    box-shadow: 0 0 16px rgb(31 107 84 / 0.55);
  }
  .syb-key:active {
    transform: translateY(4%) scale(0.95);
  }
  .syb-key:disabled {
    cursor: default;
    box-shadow: none;
  }
  .syb-key:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .syb-key.is-default {
    animation: syb-keyglow 2.8s ease-in-out infinite;
  }
  @keyframes syb-keyglow {
    0%,
    100% {
      box-shadow: 0 0 8px rgb(31 107 84 / 0.25);
    }
    50% {
      box-shadow: 0 0 20px rgb(31 107 84 / 0.6);
    }
  }
  .syb-plate {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #17181c;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: clamp(0.3rem, 1.05vw, 0.44rem);
    letter-spacing: 0.1em;
    color: #b9bcc4;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.07);
    overflow: hidden;
  }

  /* The projection */
  .syb-projection {
    position: relative;
    margin-top: 1.6rem;
    background: #0c0d10;
    border: 1px solid #1c1e24;
    border-radius: 14px;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.04),
      0 18px 44px rgb(15 16 20 / 0.25);
    overflow: hidden;
  }
  .syb-projection canvas {
    display: block;
    width: 100%;
    height: clamp(340px, 52vw, 520px);
  }
  .syb-proj-title {
    position: absolute;
    top: 0.7rem;
    left: 1rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    color: #6b7280;
    pointer-events: none;
  }
  .syb-caption {
    position: absolute;
    left: 50%;
    bottom: 0.8rem;
    transform: translateX(-50%);
    margin: 0;
    max-width: 92%;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: rgb(12 13 16 / 0.82);
    border: 1px solid #23262e;
    font-family: var(--font-mono);
    font-size: clamp(0.62rem, 1.6vw, 0.78rem);
    letter-spacing: 0.04em;
    color: #7ce8b6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .syb-caption.on {
    opacity: 1;
  }

  .syb-hint {
    margin: 1.2rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.7;
    color: var(--color-muted);
  }
  .syb-answer {
    margin-top: 1.4rem;
    border: 1px solid var(--color-faint);
    border-radius: 10px;
    background: var(--color-surface);
    padding: 1.1rem 1.25rem;
  }
  .syb-q {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .syb-a {
    margin-top: 0.6rem;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-ink);
  }
  .syb-a a {
    color: var(--color-accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .syb-a cite {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.72em;
    padding: 0.08em 0.42em;
    border: 1px solid var(--color-faint);
    border-radius: 999px;
    color: var(--color-accent-strong);
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .syb-a cite:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .syb-card {
    margin-top: 1rem;
    border: 1px solid var(--color-faint);
    border-left: 3px solid var(--color-accent);
    border-radius: 10px;
    background: var(--color-surface);
    padding: 1.1rem 1.25rem;
    position: relative;
  }
  .syb-card h3 {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 0, "WONK" 1;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .syb-card-meta {
    margin: 0.3rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .syb-card-meta .ok {
    color: var(--color-accent-strong);
  }
  .syb-tags {
    margin-top: 0.55rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .syb-tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }
  .syb-card-summary {
    margin: 0.7rem 0 0;
    font-weight: 500;
  }
  .syb-card-body {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-ink);
  }
  .syb-card-body h4 {
    margin: 0.9rem 0 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .syb-card-body a[data-wiki] {
    color: var(--color-accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .syb-card-body blockquote {
    margin: 0.6rem 0;
    padding-left: 0.9rem;
    border-left: 2px solid var(--color-faint);
    color: var(--color-muted);
  }
  .syb-locked {
    border-bottom: 1px dashed var(--color-muted);
    color: var(--color-muted);
    cursor: help;
  }
  .syb-edges {
    margin-top: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: baseline;
  }
  .syb-edges .syb-rel {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-right: 0.15rem;
  }
  .syb-chip {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    padding: 0.14rem 0.5rem;
    border: 1px solid var(--color-faint);
    border-radius: 999px;
    background: none;
    color: var(--color-accent-strong);
    cursor: pointer;
  }
  .syb-chip:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  .syb-chip-locked {
    color: var(--color-muted);
    cursor: default;
    border-style: dashed;
  }
  .syb-fresh .syb-tag,
  .syb-fresh .syb-chip {
    animation: syb-fresh 1.6s ease;
  }
  @keyframes syb-fresh {
    0% {
      box-shadow: 0 0 0 3px rgb(31 107 84 / 0.45);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(31 107 84 / 0);
    }
  }
  .syb-close {
    position: absolute;
    top: 0.6rem;
    right: 0.7rem;
    border: 0;
    background: none;
    font-size: 1.2rem;
    line-height: 1;
    color: var(--color-muted);
    cursor: pointer;
  }
  .syb-close:hover {
    color: var(--color-ink);
  }
  .syb-label {
    margin: 1.6rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.7;
    color: var(--color-muted);
  }
  .syb-label a {
    color: var(--color-accent-strong);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>

<script>
  interface VaultData {
    n: number;
    e: number;
    v: number;
    d: string;
    types: string[];
    pts: [number, number, number, number, number][];
    ed: [number, number][];
    named: Record<string, number>;
  }
  interface DemoStep {
    op: string;
    text: string;
  }
  interface DemoData {
    id: string;
    q: string;
    steps: DemoStep[];
    answerHtml: string;
    path: string[];
  }
  interface FeedData {
    slug: string;
    title: string;
    kind: string;
    file: string;
    tags: string[];
    edges: { rel: string; target: string }[];
    locked: number;
  }

  const root = document.querySelector<HTMLElement>("[data-bench]");
  const dataEl = document.querySelector("[data-syb-data]");
  if (root && dataEl) init(root, JSON.parse(dataEl.textContent || "{}"));

  function init(
    root: HTMLElement,
    data: { vault: VaultData; demos: DemoData[]; feeds: FeedData[] },
  ) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const { vault, demos, feeds } = data;
    const scene = root.querySelector<HTMLElement>("[data-scene]")!;
    const brain = root.querySelector<HTMLElement>("[data-brain]")!;
    const rig = root.querySelector<HTMLElement>("[data-rig]")!;
    const wires = root.querySelector<SVGSVGElement>("[data-wires]")!;
    const mini = root.querySelector<HTMLCanvasElement>("[data-mini]")!;
    const proj = root.querySelector<HTMLCanvasElement>("[data-proj]")!;
    const stripText = root.querySelector<HTMLElement>("[data-strip-text]")!;
    const captionEl = root.querySelector<HTMLElement>("[data-caption]")!;
    const answerBox = root.querySelector<HTMLElement>("[data-answer]")!;
    const qEl = root.querySelector<HTMLElement>("[data-q]")!;
    const aEl = root.querySelector<HTMLElement>("[data-a]")!;
    const cardBox = root.querySelector<HTMLElement>("[data-card]")!;

    const pretty = (slug: string) =>
      slug.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
    const sleep = (ms: number) =>
      reduced ? Promise.resolve() : new Promise((r) => setTimeout(r, ms));

    // ---- Wires ----
    const SOCKETS = [
      [0.117, 0.655],
      [0.117, 0.744],
      [0.117, 0.846],
    ];
    function drawWires() {
      const s = scene.getBoundingClientRect();
      const b = brain.getBoundingClientRect();
      const r = rig.getBoundingClientRect();
      const stacked = r.top > b.bottom - 10;
      wires.setAttribute("viewBox", `0 0 ${s.width} ${s.height}`);
      let html = "";
      SOCKETS.forEach((sock, i) => {
        const x2 = r.left - s.left + sock[0] * r.width;
        const y2 = r.top - s.top + sock[1] * r.height;
        let x1: number;
        let y1: number;
        if (stacked) {
          // Exit the brain's lower left and swing around the tray and bezel.
          x1 = b.left - s.left + b.width * (0.1 + i * 0.08);
          y1 = b.bottom - s.top - b.height * (0.3 - i * 0.06);
        } else {
          x1 = b.right - s.left - b.width * 0.08;
          y1 = b.top - s.top + b.height * (0.34 + i * 0.18);
        }
        const mx = stacked
          ? Math.min(x1, r.left - s.left) - 30 - i * 16
          : (x1 + x2) / 2;
        const my = stacked ? (y1 + y2) / 2 : Math.max(y1, y2) + 36 + i * 20;
        const d = `M ${x1.toFixed(1)} ${y1.toFixed(1)} Q ${mx.toFixed(1)} ${my.toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`;
        html += `<path d="${d}"/>`;
        if (!reduced) {
          for (let k = 0; k < 2; k++) {
            const dur = (3.4 + i * 0.5).toFixed(1);
            const begin = (i * 0.9 + k * 1.7).toFixed(1);
            html += `<circle r="2.6" opacity="0"><animateMotion dur="${dur}s" begin="${begin}s" repeatCount="indefinite" path="${d}"/><animate attributeName="opacity" values="0;0.9;0.9;0" keyTimes="0;0.1;0.85;1" dur="${dur}s" begin="${begin}s" repeatCount="indefinite"/></circle>`;
          }
        }
      });
      wires.innerHTML = html;
    }
    drawWires();
    new ResizeObserver(drawWires).observe(scene);

    // ---- Shared swirl state ----
    const TYPE_COLORS: Record<string, string> = {
      concept: "#e6d6a3",
      source: "#b7c6e6",
      person: "#e0b0c8",
      entity: "#7ce8b6",
      project: "#9fd6a2",
      writing: "#d9c08f",
      decision: "#a9b3d6",
      finding: "#d98a7e",
      artifact: "#8fb0a8",
      wiki: "#c9c9b8",
      doc: "#b8ab90",
      index: "#b8ab90",
      note: "#a8a89a",
    };
    const colors = vault.types.map((t) => TYPE_COLORS[t] || "#a8a89a");
    const namedIdx = new Map<number, string>();
    for (const [slug, i] of Object.entries(vault.named)) namedIdx.set(i as number, slug);

    let rotY = 0.6;
    let rotX = -0.16;
    let targetY: number | null = null;
    let lastT = 0;
    const flare = new Map<number, number>();
    let tracePath: number[] = [];
    let activeSet: Set<number> | null = null; // during a run, only these label
    let globalDim = 1; // 1 = normal, lower = dim the uninvolved
    const hidden = new Set<number>(); // dots suppressed pre-birth
    let hoverIdx: number | null = null;
    let booted = reduced;
    let bootStep = 0;

    function setupCanvas(c: HTMLCanvasElement) {
      const state = { cw: 0, ch: 0, ctx: c.getContext("2d")! };
      const size = () => {
        const r = c.getBoundingClientRect();
        const dpr = Math.min(2, devicePixelRatio || 1);
        state.cw = Math.max(1, Math.round(r.width * dpr));
        state.ch = Math.max(1, Math.round(r.height * dpr));
        c.width = state.cw;
        c.height = state.ch;
      };
      size();
      new ResizeObserver(size).observe(c);
      return state;
    }
    const miniState = setupCanvas(mini);
    const projState = setupCanvas(proj);
    const projPts: [number, number, number][] = new Array(vault.pts.length);

    function advance(t: number) {
      const dt = lastT ? Math.min(0.05, (t - lastT) / 1000) : 0.016;
      lastT = t;
      if (reduced) return;
      if (targetY !== null) {
        const diff = ((targetY - rotY + Math.PI * 3) % (Math.PI * 2)) - Math.PI;
        rotY += diff * Math.min(1, dt * 3);
        if (Math.abs(diff) < 0.02) targetY = null;
      } else {
        rotY += dt * 0.1;
      }
      for (const [i, f] of flare) flare.set(i, Math.max(0, f - dt * 0.65));
    }

    function paint(
      s: { cw: number; ch: number; ctx: CanvasRenderingContext2D },
      labels: boolean,
      keepProj: boolean,
      t: number,
    ) {
      const { cw, ch, ctx } = s;
      ctx.clearRect(0, 0, cw, ch);
      if (!booted && !labels) {
        ctx.fillStyle = "#9fe0b0";
        ctx.font = `${Math.round(ch * 0.075)}px ui-monospace, Menlo, monospace`;
        const lines = [
          "SYNAPSE READER",
          `${vault.n} nodes · ${vault.e} edges`,
          "reading" + ".".repeat(1 + (Math.floor(t / 400) % 3)),
        ].slice(0, bootStep);
        lines.forEach((l, i) => ctx.fillText(l, ch * 0.08, ch * (0.2 + i * 0.14)));
        return;
      }
      const cy = Math.cos(rotY);
      const sy = Math.sin(rotY);
      const cx = Math.cos(rotX);
      const sx = Math.sin(rotX);
      const R = Math.min(cw, ch) * (labels ? 0.62 : 0.56);
      const cxp = cw / 2;
      const cyp = ch / 2;
      const local: [number, number, number][] = keepProj ? projPts : new Array(vault.pts.length);
      for (let i = 0; i < vault.pts.length; i++) {
        const [x, y, z] = vault.pts[i];
        const x1 = x * cy + z * sy;
        const z1 = -x * sy + z * cy;
        const y1 = y * cx - z1 * sx;
        const z2 = y * sx + z1 * cx;
        const depth = (z2 + 1.2) / 2.2;
        local[i] = [cxp + x1 * R, cyp + y1 * R * 0.92, depth];
      }
      ctx.lineWidth = 1;
      ctx.strokeStyle = `rgba(214, 224, 205, ${0.1 * globalDim})`;
      ctx.beginPath();
      for (const [a, b] of vault.ed) {
        if (hidden.has(a) || hidden.has(b)) continue;
        ctx.moveTo(local[a][0], local[a][1]);
        ctx.lineTo(local[b][0], local[b][1]);
      }
      ctx.stroke();
      if (tracePath.length > 1) {
        ctx.lineWidth = labels ? 2.4 : 1.8;
        ctx.strokeStyle = "rgba(124, 232, 182, 0.9)";
        ctx.beginPath();
        tracePath.forEach((n, k) => {
          if (k === 0) ctx.moveTo(local[n][0], local[n][1]);
          else ctx.lineTo(local[n][0], local[n][1]);
        });
        ctx.stroke();
      }
      const px = cw / 640;
      for (let i = 0; i < vault.pts.length; i++) {
        if (hidden.has(i)) continue;
        const [X, Y, depth] = local[i];
        const named = namedIdx.has(i);
        const deg = vault.pts[i][4];
        const f = flare.get(i) || 0;
        const involved = !activeSet || activeSet.has(i) || f > 0;
        let r = (0.9 + Math.min(2.2, deg * 0.14) + (named ? 1.6 : 0)) * (0.55 + depth * 0.75);
        let alpha = (named ? 0.55 + depth * 0.45 : 0.22 + depth * 0.5) * (involved ? 1 : globalDim);
        if (f > 0) {
          r += f * 4.5;
          alpha = Math.min(1, alpha + f);
        }
        if (hoverIdx === i) {
          r += 1.5;
          alpha = 1;
        }
        ctx.globalAlpha = alpha;
        ctx.fillStyle = colors[vault.pts[i][3]] || "#a8a89a";
        ctx.beginPath();
        ctx.arc(X, Y, r * px, 0, Math.PI * 2);
        ctx.fill();
        if (f > 0.05 || hoverIdx === i) {
          ctx.globalAlpha = Math.max(f * 0.45, hoverIdx === i ? 0.5 : 0);
          ctx.beginPath();
          ctx.arc(X, Y, (r + 5) * px, 0, Math.PI * 2);
          ctx.strokeStyle = "#7ce8b6";
          ctx.lineWidth = 1.4;
          ctx.stroke();
        }
        // Labels: on the projection only. Idle shows the front slice; during
        // a run only the involved nodes keep their names.
        if (labels && named) {
          const show = activeSet
            ? activeSet.has(i)
            : depth > 0.7 || f > 0.05 || hoverIdx === i;
          if (show) {
            ctx.globalAlpha = Math.min(1, (activeSet ? 1 : (depth - 0.55) * 2.6) + f);
            ctx.fillStyle = hoverIdx === i || f > 0.2 ? "#a8f0cd" : "#8fae9c";
            ctx.font = `${Math.round(10.5 * px)}px ui-monospace, Menlo, monospace`;
            ctx.fillText(namedIdx.get(i)!, X + (r + 7) * px, Y + 3 * px);
          }
        }
      }
      ctx.globalAlpha = 1;
    }

    // rAF paints pixels only; nothing waits on it (the sword room's lesson).
    let miniVisible = false;
    let projVisible = false;
    function loop(t: number) {
      advance(t);
      if (miniVisible) paint(miniState, false, false, t);
      if (projVisible) paint(projState, true, true, t);
      requestAnimationFrame(loop);
    }
    requestAnimationFrame(loop);

    new IntersectionObserver(
      (es) => {
        for (const e of es) {
          if (e.target === mini) miniVisible = e.isIntersecting;
          if (e.target === proj) projVisible = e.isIntersecting;
        }
        if ((miniVisible || projVisible) && !booted && bootStep === 0) boot();
      },
      { threshold: 0.15 },
    ).observe(mini);
    new IntersectionObserver(
      (es) => {
        for (const e of es) projVisible = e.isIntersecting;
        if (projVisible && !booted && bootStep === 0) boot();
      },
      { threshold: 0.15 },
    ).observe(proj);

    let userTouched = false;
    function boot() {
      bootStep = 1;
      setTimeout(() => (bootStep = 2), 450);
      setTimeout(() => (bootStep = 3), 900);
      setTimeout(() => {
        booted = true;
      }, 2000);
      setStrip("SYNAPSE ONLINE");
    }

    function focusNode(i: number, strength = 1) {
      const [x, , z] = vault.pts[i];
      targetY = Math.atan2(-x, z) + Math.PI;
      flare.set(i, strength);
    }

    // ---- Caption and strip ----
    let capTimer = 0;
    function caption(text: string, holdMs = 0) {
      captionEl.textContent = text;
      captionEl.classList.add("on");
      clearTimeout(capTimer);
      if (holdMs) capTimer = window.setTimeout(() => captionEl.classList.remove("on"), holdMs);
    }
    function captionOff() {
      clearTimeout(capTimer);
      captionEl.classList.remove("on");
    }
    let stripTimer = 0;
    function setStrip(text: string) {
      stripText.textContent = text;
    }
    const idleLines = () => {
      const names = Object.keys(vault.named);
      const pick = names[Math.floor(Math.random() * names.length)];
      return [
        `${vault.n} NODES · ${vault.e} EDGES`,
        `${vault.v} VERIFIED`,
        `· ${pretty(pick).toUpperCase()}`,
      ][Math.floor(Math.random() * 3)];
    };
    function idleStrip() {
      clearInterval(stripTimer);
      stripTimer = window.setInterval(() => setStrip(idleLines()), 5200);
    }
    setStrip(`${vault.n} NODES · ${vault.e} EDGES`);
    idleStrip();

    // ---- Node cards ----
    let nodesCache: Record<string, any> | null = null;
    async function getNodes() {
      if (nodesCache) return nodesCache;
      const res = await fetch("/synapse/nodes.json");
      const j = await res.json();
      nodesCache = {};
      for (const n of j.nodes) nodesCache[n.id] = n;
      return nodesCache;
    }

    const REL_LABELS: Record<string, string> = {
      supports: "supports",
      contradicts: "contradicts",
      depends_on: "depends on",
      derived_from: "derived from",
      part_of: "part of",
      preceded_by: "preceded by",
      followed_by: "followed by",
      related_to: "related to",
      restates: "restates",
      supersedes: "supersedes",
    };

    async function openCard(slug: string, fresh = false) {
      const nodes = await getNodes();
      const n = nodes[slug];
      if (!n) return;
      const i = vault.named[slug];
      if (i !== undefined) focusNode(i);
      const ok = n.status === "verified";
      const tags = (n.tags || [])
        .map((t: string) => `<span class="syb-tag">${t}</span>`)
        .join("");
      let edges = "";
      for (const [rel, targets] of Object.entries(n.edges || {})) {
        if (rel.endsWith("_locked")) continue;
        const chips = (targets as string[])
          .map((t) => `<button type="button" class="syb-chip" data-open="${t}">${t}</button>`)
          .join("");
        const lockedN = (n.edges || {})[rel + "_locked"];
        const locked = lockedN
          ? `<span class="syb-chip syb-chip-locked" title="These stay private">+${lockedN} private</span>`
          : "";
        edges += `<span class="syb-rel">${REL_LABELS[rel] || rel}</span>${chips}${locked}`;
      }
      cardBox.classList.toggle("syb-fresh", fresh);
      cardBox.innerHTML =
        `<button type="button" class="syb-close" data-close aria-label="Close">&times;</button>` +
        `<h3>${n.title}</h3>` +
        `<p class="syb-card-meta">${n.kind} · <span class="${ok ? "ok" : ""}">${n.status}</span>${
          n.provenance ? ` · ${n.provenance}` : ""
        }</p>` +
        (tags ? `<div class="syb-tags">${tags}</div>` : "") +
        (n.summary ? `<p class="syb-card-summary">${n.summary}</p>` : "") +
        `<div class="syb-card-body">${n.bodyHtml}</div>` +
        (edges ? `<div class="syb-edges">${edges}</div>` : "");
      cardBox.hidden = false;
      cardBox.querySelector("[data-close]")!.addEventListener("click", () => {
        cardBox.hidden = true;
      });
      cardBox.querySelectorAll<HTMLElement>("[data-open]").forEach((b) =>
        b.addEventListener("click", () => openCard(b.dataset.open!)),
      );
      cardBox.querySelectorAll<HTMLAnchorElement>("a[data-wiki]").forEach((a) =>
        a.addEventListener("click", (ev) => {
          ev.preventDefault();
          openCard(a.getAttribute("href")!.replace("#node/", ""));
        }),
      );
      cardBox.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "nearest" });
    }

    // ---- Projection interaction ----
    function projHit(ev: MouseEvent): number | null {
      const r = proj.getBoundingClientRect();
      const dpr = projState.cw / r.width;
      const mx = (ev.clientX - r.left) * dpr;
      const my = (ev.clientY - r.top) * dpr;
      let best: number | null = null;
      let bestD = 20 * dpr;
      for (const [i] of namedIdx) {
        const p = projPts[i];
        if (!p) continue;
        const d = Math.hypot(p[0] - mx, p[1] - my);
        if (d < bestD) {
          bestD = d;
          best = i;
        }
      }
      return best;
    }
    proj.addEventListener("mousemove", (ev) => {
      hoverIdx = projHit(ev);
      proj.style.cursor = hoverIdx !== null ? "pointer" : "default";
    });
    proj.addEventListener("mouseleave", () => (hoverIdx = null));
    proj.addEventListener("click", (ev) => {
      userTouched = true;
      const i = projHit(ev);
      if (i !== null) openCard(namedIdx.get(i)!);
    });

    // ---- ASK ----
    let running = false;
    function setControls(disabled: boolean) {
      root
        .querySelectorAll<HTMLButtonElement>("[data-key], [data-feed]")
        .forEach((k) => (k.disabled = disabled));
    }
    async function runAsk(demo: DemoData) {
      if (running) return;
      running = true;
      setControls(true);
      clearInterval(stripTimer);
      answerBox.hidden = true;
      cardBox.hidden = true;
      tracePath = [];
      activeSet = new Set(demo.path.map((s) => vault.named[s]).filter((i) => i !== undefined));
      globalDim = 0.28;
      wires.classList.add("firing");
      caption(demo.q.toUpperCase());
      setStrip("READING…");
      await sleep(650);
      for (const step of demo.steps) {
        setStrip(`${step.op.toUpperCase()} ${step.text}`.slice(0, 52));
        let hopped = false;
        for (const slug of demo.path) {
          if (step.text.includes(slug)) {
            const i = vault.named[slug];
            if (i !== undefined) {
              focusNode(i, 1.2);
              if (!tracePath.includes(i)) tracePath.push(i);
              if (step.op === "hop" || step.op === "open" || step.op === "match") {
                caption(step.op === "hop" ? step.text : slug);
                hopped = true;
              }
            }
          }
        }
        if (!hopped && (step.op === "scan" || step.op === "check" || step.op === "write")) {
          caption(step.op.toUpperCase() + " · " + step.text.split("·")[0].trim());
        }
        await sleep(760);
      }
      qEl.textContent = demo.q;
      aEl.innerHTML = demo.answerHtml;
      aEl.querySelectorAll("cite").forEach((c) =>
        c.addEventListener("click", () => openCard(c.getAttribute("data-n")!)),
      );
      answerBox.hidden = false;
      setStrip(`DONE · CITED ${demo.path.length} NODES`);
      caption(`ANSWERED · ${demo.path.length} CITATIONS`, 3600);
      wires.classList.remove("firing");
      answerBox.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "nearest" });
      setTimeout(() => {
        tracePath = [];
        activeSet = null;
        globalDim = 1;
        idleStrip();
      }, 5200);
      running = false;
      setControls(false);
    }

    // ---- FEED ----
    async function runFeed(feed: FeedData, scrapEl: HTMLElement) {
      if (running) return;
      running = true;
      setControls(true);
      clearInterval(stripTimer);
      answerBox.hidden = true;
      cardBox.hidden = true;
      const i = vault.named[feed.slug];
      // The scrap flies into the brain.
      if (!reduced) {
        const from = scrapEl.getBoundingClientRect();
        const to = brain.getBoundingClientRect();
        const ghost = scrapEl.cloneNode(true) as HTMLElement;
        Object.assign(ghost.style, {
          position: "fixed",
          left: `${from.left}px`,
          top: `${from.top}px`,
          width: `${from.width}px`,
          margin: "0",
          zIndex: "50",
          pointerEvents: "none",
        });
        document.body.appendChild(ghost);
        const dx = to.left + to.width * 0.5 - from.left - from.width * 0.5;
        const dy = to.top + to.height * 0.55 - from.top;
        ghost.animate(
          [
            { transform: "translate(0,0) scale(1) rotate(0deg)", opacity: 1 },
            { transform: `translate(${dx}px,${dy}px) scale(0.15) rotate(-8deg)`, opacity: 0 },
          ],
          { duration: 700, easing: "cubic-bezier(0.4, 0, 0.7, 1)" },
        ).onfinish = () => ghost.remove();
      }
      setStrip(`CAPTURE ${feed.file}`.slice(0, 52));
      await sleep(720);
      wires.classList.add("firing");
      globalDim = 0.15;
      activeSet = new Set(i !== undefined ? [i] : []);
      if (i !== undefined) {
        hidden.add(i);
        await sleep(420);
        hidden.delete(i);
        focusNode(i, 1.7);
        caption(`NEW NODE · ${feed.title}`);
        setStrip(`WRITE nodes/${feed.slug}.md`.slice(0, 52));
      }
      await sleep(1100);
      for (const tag of feed.tags) {
        caption(`tagged: ${tag}`);
        setStrip(`TAG ${tag}`);
        await sleep(720);
      }
      for (const e of feed.edges) {
        const j = vault.named[e.target];
        caption(`${e.rel} → ${e.target}`);
        setStrip(`LINK ${e.rel} → ${e.target}`.slice(0, 52));
        if (j !== undefined && i !== undefined) {
          activeSet.add(j);
          tracePath = [i, j];
          focusNode(j, 1);
        }
        await sleep(940);
      }
      if (feed.locked) {
        caption(`+${feed.locked} private connections`);
        await sleep(820);
      }
      caption(`FILED · ${feed.title}`, 3600);
      setStrip("CAPTURED · AUTO-TAGGED · LINKED");
      wires.classList.remove("firing");
      await openCard(feed.slug, true);
      setTimeout(() => {
        tracePath = [];
        activeSet = null;
        globalDim = 1;
        idleStrip();
      }, 5200);
      running = false;
      setControls(false);
    }

    // ---- Controls ----
    const defaultKey = root.querySelector<HTMLButtonElement>(`[data-key="${demos[0].id}"]`);
    defaultKey?.classList.add("is-default");
    root.querySelectorAll<HTMLButtonElement>("[data-key]").forEach((k) =>
      k.addEventListener("click", () => {
        userTouched = true;
        defaultKey?.classList.remove("is-default");
        const demo = demos.find((d) => d.id === k.dataset.key);
        if (demo) runAsk(demo);
      }),
    );
    root.querySelectorAll<HTMLButtonElement>("[data-feed]").forEach((s) =>
      s.addEventListener("click", () => {
        userTouched = true;
        const feed = feeds.find((f) => f.slug === s.dataset.feed);
        if (feed) runFeed(feed, s);
      }),
    );

    // Idle shimmer.
    if (!reduced) {
      setInterval(() => {
        if (!running && (miniVisible || projVisible)) {
          flare.set(Math.floor(Math.random() * vault.pts.length), 0.5);
        }
      }, 2600);
    }
  }
</script>

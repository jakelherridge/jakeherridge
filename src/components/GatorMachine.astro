---
// The Glitchy Gator Machine: the rendered cabinet IS the machine. The art
// screen, the six reel windows, and the big red button are live regions
// positioned over the render (percentages measured off the 888x1472 image;
// see scratch overlay-proof). Press the dome and every reel pulls with the
// collection's REAL rarity weights, so a pull lands traits as often as the
// 2021 mint did.
//
// The render's own tiny labels were AI-garbled, so clean plates cover them.
// Trait names and odds live beside the machine at readable sizes; the page is
// white, the machine is the only object on it.
import { Image } from "astro:assets";
import manifest from "../data/gator-machine.json";
import renderImg from "../assets/gators/machine-render.png";

interface Item {
  slug: string;
  name: string;
  weight: number;
  glitchy?: boolean;
}
interface Category {
  id: string;
  label: string;
  items: Item[];
}
const categories = manifest.categories as Category[];

// A light default so first paint is cheap: plain background, no glow body.
const DEFAULTS: Record<string, string> = {
  background: "green",
  body: "green-machine",
  arms: "boxer",
  mouth: "cheesy",
  eyes: "cute",
  head: "burger",
};

const pick = (c: Category) =>
  c.items.find((i) => i.slug === DEFAULTS[c.id]) ??
  c.items.reduce((a, b) => (b.weight > a.weight ? b : a));

const initial = categories.map((c) => ({ cat: c, item: pick(c) }));
const combos = categories.reduce((n, c) => n * c.items.length, 1);

// Live regions as percentages of the render. Measured, not eyeballed.
const SCREEN = { x: 25.68, y: 8.97, w: 47.3, h: 24.46 };
// Window height reaches the full glass so the art centres in it instead of
// riding high with baked-in glass showing underneath.
const WIN = { y: 37.3, h: 8.95, w: 9.91, xs: [13.29, 25.68, 38.06, 50.45, 62.84, 75.23] };
const PLATE = { y: 46.2, h: 2.99, w: 11.11, dx: -0.6 };
const BTN = { x: 40.77, y: 48.91, w: 16.89 };
---

<section id="machine" class="scroll-mt-20 gm" data-machine data-size={manifest.size}>
  <!-- The machine -->
  <div class="gm-scene">
    <div class="gm-rig" data-rig>
      <Image
        src={renderImg}
        alt=""
        widths={[444, 666, 888]}
        sizes="(max-width: 900px) 92vw, 460px"
        format="png"
        class="gm-render"
        loading="eager"
      />

      <!-- Art screen: the composed gator, covering the render's baked one -->
      <div
        class="gm-live"
        style={`left:${SCREEN.x}%;top:${SCREEN.y}%;width:${SCREEN.w}%;height:${SCREEN.h}%`}
      >
        {/* The screen is a touch wider than the square art. The background
            layer alone stretches to fill the glass (a flat colour does not
            mind), and the gator sits on it uncropped and unmorphed. */}
        <img
          data-bgfill
          class="gm-bgfill"
          src={`/gators/layers/background/${initial[0].item.slug}.webp`}
          alt=""
          aria-hidden="true"
        />
        <div
          class="gm-stack"
          data-stage
          role="img"
          aria-label={`A gator built from: ${initial.map((s) => s.item.name).join(", ")}`}
        >
          {
            initial.map(({ cat, item }) => (
              <img
                data-layer={cat.id}
                src={`/gators/layers/${cat.id}/${item.slug}.webp`}
                alt=""
                width={manifest.size}
                height={manifest.size}
                decoding="async"
                fetchpriority={cat.id === "background" ? "high" : "auto"}
              />
            ))
          }
        </div>
      </div>

      <!-- Six reel windows -->
      {
        categories.map((c, i) => {
          const item = initial.find((s) => s.cat.id === c.id)!.item;
          return (
            <div
              class="gm-win"
              data-win={c.id}
              style={`left:${WIN.xs[i]}%;top:${WIN.y}%;width:${WIN.w}%;height:${WIN.h}%`}
            >
              <div class="gm-strip" data-strip={c.id}>
                <div class="gm-cell">
                  <img
                    src={`/gators/thumbs/${c.id}/${item.slug}.webp`}
                    alt=""
                    width="144"
                    height="144"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            </div>
          );
        })
      }

      <!-- Clean label plates over the render's garbled ones -->
      {
        categories.map((c, i) => (
          <span
            class="gm-plate"
            aria-hidden="true"
            style={`left:${WIN.xs[i] + PLATE.dx}%;top:${PLATE.y}%;width:${PLATE.w}%;height:${PLATE.h}%`}
          >
            {c.id === "background" ? "BG" : c.label}
          </span>
        ))
      }

      <!-- The button: the render's red dome, made real -->
      <button
        type="button"
        class="gm-dome"
        data-spin
        aria-label="Mint a gator"
        style={`left:${BTN.x}%;top:${BTN.y}%;width:${BTN.w}%`}
      ></button>
      {/* The invitation. Bounces over the dome until the first press. */}
      <span
        class="gm-press"
        data-press
        aria-hidden="true"
        style={`left:${BTN.x + BTN.w / 2}%;top:${BTN.y - 6.2}%`}
      >
        press &darr;
      </span>
    </div>
  </div>

  <!-- The readout, at reading size on the white page -->
  <div class="gm-panel">
    <p class="gm-count">
      {combos.toLocaleString("en-US")} possible gators. Rolled with the 2021 mint's real rarity
      weights.
    </p>
    <dl class="gm-spec" data-recipe aria-live="polite">
      {
        initial.map(({ cat, item }) => (
          <div class="gm-spec-cell">
            <dt>{cat.label}</dt>
            <dd data-spec={cat.id} title={item.name}>
              {item.name}
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="gm-odds" data-odds></p>
    <div class="gm-actions">
      <button type="button" class="gm-btn" data-download>Download PNG</button>
    </div>
  </div>

  <script
    type="application/json"
    data-machine-data
    set:html={JSON.stringify(
      categories.map((c) => ({ id: c.id, label: c.label, items: c.items })),
    )}
  />
</section>

{/* is:global is required, not stylistic: spinReel injects .gm-cell markup at
    runtime, and scoped selectors would not match it, which collapsed the
    landed cells and pinned the art to the window top until this was fixed. */}
<style is:global>
  .gm {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .gm {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 2.5rem;
    }
  }

  /* The machine settles into place as it enters the viewport: a small 3D
     arrival, not a carnival. */
  .gm-scene {
    perspective: 1600px;
    display: flex;
    justify-content: center;
  }
  .gm-rig {
    position: relative;
    width: min(92vw, 460px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .gm-rig {
      transform: rotateX(14deg) rotateY(-11deg) scale(0.93) translateY(30px);
      opacity: 0.4;
      transition:
        transform 1s cubic-bezier(0.22, 0.9, 0.3, 1),
        opacity 0.7s ease;
    }
    .gm-rig.is-set {
      transform: none;
      opacity: 1;
    }
  }
  .gm-render {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 18px 30px rgb(27 26 23 / 0.22));
  }

  /* Live regions sit on the render by percentage. */
  .gm-live {
    position: absolute;
    overflow: hidden;
    border-radius: 6px;
    background: #0c0d10;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gm-bgfill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* The gator fits the screen whole: full height, square, centred, nothing
     cropped or stretched. The bgfill behind carries the leftover width. */
  .gm-stack {
    position: relative;
    height: 100%;
    aspect-ratio: 1;
    flex: none;
  }
  .gm-stack img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .gm-stack img.landing {
      animation: gm-land 0.28s cubic-bezier(0.2, 0.9, 0.3, 1);
    }
  }
  @keyframes gm-land {
    0% {
      opacity: 0.3;
      transform: scale(1.02);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  .gm-win {
    position: absolute;
    overflow: hidden;
    border-radius: 8%/4.5%;
    background: #f5f4f0;
  }
  .gm-strip {
    will-change: transform;
  }
  .gm-cell {
    height: var(--cell, 100px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gm-cell img {
    max-width: 86%;
    max-height: 86%;
    width: auto;
    height: auto;
    display: block;
  }

  .gm-plate {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #17181c;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: clamp(0.4rem, 1.9vw, 0.56rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #b9bcc4;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.07);
  }
  @media (min-width: 900px) {
    .gm-plate {
      font-size: 0.52rem;
    }
  }

  /* The dome. The render supplies the button; this supplies the press. */
  .gm-dome {
    position: absolute;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 0;
    background: radial-gradient(
      circle at 38% 30%,
      rgb(255 255 255 / 0.14),
      rgb(255 60 60 / 0.05) 45%,
      transparent 70%
    );
    cursor: pointer;
    transition:
      box-shadow 0.2s ease,
      transform 0.1s ease,
      filter 0.15s ease;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* The glow breathes, the dome bobs up and down, and every few seconds it
       gives one quick wiggle: press me. Bob and wiggle ride the standalone
       translate and rotate properties so the :active press transform still
       works on top. */
    .gm-dome {
      animation:
        gm-beckon 3.2s ease-in-out infinite,
        gm-wiggle 5.4s ease-in-out infinite,
        gm-bob 1.6s ease-in-out infinite alternate;
    }
  }
  @keyframes gm-bob {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 -7%;
    }
  }
  .gm-press {
    position: absolute;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: clamp(0.5rem, 1.6vw, 0.68rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
    background: #fff;
    border: 1px solid var(--color-faint);
    border-radius: 999px;
    padding: 0.22em 0.7em;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.3);
    pointer-events: none;
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: no-preference) {
    .gm-press {
      animation: gm-press-bounce 0.9s ease-in-out infinite alternate;
    }
  }
  @keyframes gm-press-bounce {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 -7px;
    }
  }
  @keyframes gm-beckon {
    0%,
    100% {
      box-shadow: 0 0 22px rgb(229 60 60 / 0.25);
    }
    50% {
      box-shadow: 0 0 44px rgb(229 60 60 / 0.55);
    }
  }
  @keyframes gm-wiggle {
    0%,
    86%,
    100% {
      rotate: 0deg;
    }
    88% {
      rotate: 6deg;
    }
    91% {
      rotate: -5deg;
    }
    94% {
      rotate: 3deg;
    }
    97% {
      rotate: -2deg;
    }
  }
  .gm-dome:hover {
    box-shadow: 0 0 54px rgb(229 60 60 / 0.65);
    filter: brightness(1.06);
  }
  .gm-dome:active {
    transform: translateY(2%) scale(0.97);
  }
  .gm-dome:disabled {
    cursor: default;
    animation: none;
    box-shadow: none;
  }
  .gm-dome:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  /* The readout: normal reading sizes, ink on paper. */
  .gm-count {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--color-muted);
  }
  .gm-spec {
    margin: 1.1rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem 1.2rem;
  }
  .gm-spec-cell {
    min-width: 0;
  }
  .gm-spec dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    line-height: 1.5;
  }
  .gm-spec dd {
    margin: 0.1rem 0 0;
    font-size: 1.02rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
    min-height: 2.7em;
  }
  .gm-spec dd.is-glitchy {
    color: var(--color-accent);
  }
  .gm-odds {
    margin: 1.1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--color-accent-strong);
    min-height: 1.4em;
  }
  .gm-actions {
    margin-top: 1.1rem;
  }
  .gm-btn {
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.55rem 1rem;
    border-radius: 5px;
    border: 1px solid var(--color-faint);
    background: var(--color-surface);
    color: var(--color-ink);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .gm-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>

<script>
  interface MItem {
    slug: string;
    name: string;
    weight: number;
    glitchy?: boolean;
  }
  interface MCat {
    id: string;
    label: string;
    items: MItem[];
  }

  const root = document.querySelector<HTMLElement>("[data-machine]");
  const dataEl = document.querySelector("[data-machine-data]");
  if (root && dataEl) init(root, JSON.parse(dataEl.textContent || "[]"));

  function init(root: HTMLElement, categories: MCat[]) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const stage = root.querySelector<HTMLElement>("[data-stage]")!;
    const recipe = root.querySelector<HTMLElement>("[data-recipe]")!;
    const oddsEl = root.querySelector<HTMLElement>("[data-odds]")!;
    const spinBtn = root.querySelector<HTMLButtonElement>("[data-spin]")!;

    // The machine arrives.
    const rig = root.querySelector<HTMLElement>("[data-rig]")!;
    new IntersectionObserver(
      (entries, obs) => {
        if (entries.some((e) => e.isIntersecting)) {
          rig.classList.add("is-set");
          obs.disconnect();
        }
      },
      { threshold: 0.25 },
    ).observe(rig);

    // Reel cells are sized by the window they live in, because the windows
    // scale with the render. Measured fresh whenever the machine resizes.
    const setCell = () => {
      root.querySelectorAll<HTMLElement>("[data-win]").forEach((w) => {
        w.style.setProperty("--cell", `${w.clientHeight}px`);
      });
    };
    setCell();
    new ResizeObserver(setCell).observe(rig);

    const layerImgs = new Map<string, HTMLImageElement>();
    stage.querySelectorAll<HTMLImageElement>("[data-layer]").forEach((img) => {
      layerImgs.set(img.dataset.layer!, img);
    });

    const state = new Map<string, string>();
    categories.forEach((c) => {
      const img = layerImgs.get(c.id)!;
      state.set(c.id, decodeURIComponent(img.src.split("/").pop()!.replace(".webp", "")));
    });

    const byId = new Map(categories.map((c) => [c.id, c]));
    const itemOf = (catId: string, slug: string) =>
      byId.get(catId)!.items.find((i) => i.slug === slug);
    const totalWeight = new Map(
      categories.map((c) => [c.id, c.items.reduce((n, i) => n + i.weight, 0)]),
    );

    // Weighted pull: the collection's own distribution.
    function rollItem(c: MCat): MItem {
      let r = Math.random() * totalWeight.get(c.id)!;
      for (const item of c.items) {
        r -= item.weight;
        if (r <= 0) return item;
      }
      return c.items[c.items.length - 1];
    }

    const oneIn = (p: number) => {
      const n = 1 / p;
      if (n >= 1e12) return `1 in ${(n / 1e12).toFixed(1)} trillion`;
      if (n >= 1e9) return `1 in ${(n / 1e9).toFixed(1)} billion`;
      if (n >= 1e6) return `1 in ${(n / 1e6).toFixed(1)} million`;
      if (n >= 1e3) return `1 in ${Math.round(n / 1e3)},000`;
      return `1 in ${Math.max(2, Math.round(n))}`;
    };

    function updateMeta() {
      const parts = categories.map((c) => itemOf(c.id, state.get(c.id)!)?.name ?? state.get(c.id)!);
      categories.forEach((c, i) => {
        const cell = recipe.querySelector<HTMLElement>(`[data-spec="${c.id}"]`);
        if (!cell) return;
        cell.textContent = parts[i];
        cell.title = parts[i];
        cell.classList.toggle("is-glitchy", Boolean(itemOf(c.id, state.get(c.id)!)?.glitchy));
      });
      stage.setAttribute("aria-label", `A gator built from: ${parts.join(", ")}`);
      let p = 1;
      for (const c of categories) {
        const it = itemOf(c.id, state.get(c.id)!);
        if (it) p *= it.weight / totalWeight.get(c.id)!;
      }
      oddsEl.textContent = `this exact gator: ${oneIn(p)}`;
      history.replaceState(null, "", "#g=" + categories.map((c) => state.get(c.id)).join("."));
    }

    // Preload with a timeout race: a detached Image can stall forever.
    function preload(url: string) {
      return new Promise<void>((resolve) => {
        const im = new Image();
        let done = false;
        const fin = () => {
          if (!done) {
            done = true;
            resolve();
          }
        };
        im.onload = fin;
        im.onerror = fin;
        setTimeout(fin, 1500);
        im.src = url;
      });
    }

    const bgFill = root.querySelector<HTMLImageElement>("[data-bgfill]");

    async function setLayer(catId: string, slug: string, animate = true) {
      state.set(catId, slug);
      const img = layerImgs.get(catId)!;
      const url = `/gators/layers/${catId}/${slug}.webp`;
      await preload(url);
      if (state.get(catId) !== slug) return;
      img.src = url;
      // The stretched fill behind the square art follows the background reel.
      if (catId === "background" && bgFill) bgFill.src = url;
      if (animate && !reduced) {
        img.classList.remove("landing");
        void img.offsetWidth;
        img.classList.add("landing");
      }
    }

    function cellHtml(catId: string, item: MItem) {
      return `<div class="gm-cell"><img src="/gators/thumbs/${catId}/${item.slug}.webp" alt="" width="144" height="144" loading="lazy" decoding="async"></div>`;
    }

    function setReel(catId: string, item: MItem) {
      const strip = root.querySelector<HTMLElement>(`[data-strip="${catId}"]`)!;
      strip.style.transition = "none";
      strip.style.transform = "translateY(0)";
      strip.innerHTML = cellHtml(catId, item);
    }

    // Spin one reel: a sampled strip that lands on the target. The cell size
    // comes from the live window height, since the machine scales with the
    // viewport.
    function spinReel(catId: string, target: MItem, duration: number): Promise<void> {
      const c = byId.get(catId)!;
      const strip = root.querySelector<HTMLElement>(`[data-strip="${catId}"]`)!;
      const win = root.querySelector<HTMLElement>(`[data-win="${catId}"]`)!;
      const cell = win.clientHeight;
      if (reduced || !cell) {
        setReel(catId, target);
        return Promise.resolve();
      }
      const runners: MItem[] = [];
      for (let i = 0; i < 14; i++) {
        runners.push(c.items[Math.floor(Math.random() * c.items.length)]);
      }
      runners.push(target);
      strip.style.transition = "none";
      strip.style.transform = "translateY(0)";
      strip.innerHTML = runners.map((it) => cellHtml(catId, it)).join("");
      void strip.offsetWidth;
      return new Promise((resolve) => {
        strip.style.transition = `transform ${duration}ms cubic-bezier(0.16, 0.62, 0.2, 1)`;
        strip.style.transform = `translateY(-${(runners.length - 1) * cell}px)`;
        const done = () => {
          strip.removeEventListener("transitionend", done);
          setReel(catId, target);
          resolve();
        };
        strip.addEventListener("transitionend", done);
        setTimeout(done, duration + 400);
      });
    }

    let spinning = false;
    async function spin() {
      if (spinning) return;
      spinning = true;
      // The invitation has done its job.
      root.querySelector("[data-press]")?.remove();
      spinBtn.disabled = true;
      const targets = new Map<string, MItem>();
      for (const c of categories) {
        targets.set(c.id, rollItem(c));
      }
      // Warm the layers while the reels are still turning.
      const warm = [...targets.entries()].map(([id, it]) =>
        preload(`/gators/layers/${id}/${it.slug}.webp`),
      );
      const spins = [...targets.entries()].map(([id, it], i) =>
        new Promise<void>((res) => {
          setTimeout(
            () =>
              spinReel(id, it, 900 + i * 260).then(() => {
                setLayer(id, it.slug);
                updateMeta();
                res();
              }),
            reduced ? 0 : i * 90,
          );
        }),
      );
      await Promise.all([...spins, ...warm]);
      spinning = false;
      spinBtn.disabled = false;
    }

    spinBtn.addEventListener("click", spin);

    // Download: composite the on-screen layers.
    root.querySelector("[data-download]")!.addEventListener("click", () => {
      const size = parseInt(root.dataset.size || "600", 10);
      const canvas = document.createElement("canvas");
      canvas.width = canvas.height = size;
      const ctx = canvas.getContext("2d")!;
      for (const c of categories) {
        const img = layerImgs.get(c.id)!;
        if (img.complete && img.naturalWidth > 0) ctx.drawImage(img, 0, 0, size, size);
      }
      canvas.toBlob((blob) => {
        if (!blob) return;
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = "glitchy-gator.png";
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 5000);
      }, "image/png");
    });

    // Restore a shared gator.
    const m = location.hash.match(/g=([a-z0-9.\-]+)/i);
    if (m) {
      const slugs = m[1].split(".");
      categories.forEach((c, i) => {
        const it = slugs[i] && itemOf(c.id, slugs[i]);
        if (it) {
          setReel(c.id, it);
          setLayer(c.id, it.slug, false);
        }
      });
    }
    updateMeta();
  }
</script>

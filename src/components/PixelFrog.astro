---
// Aldo lives on the footer ledge. The real one: PocketWild's idle-bob sprite
// sheet (2x2 frames of 128px), animated by stepping the background position,
// pixels kept square. Click him for a field note.
---

<div class="frog-perch" data-frog-root>
  <p class="frog-bubble" id="frog-bubble" role="status" aria-live="polite" hidden></p>
  <button
    type="button"
    class="frog-button"
    id="frog-button"
    aria-label="Aldo the frog. Press for a field note."
    title="ribbit"
  >
    <span class="aldo-sprite" aria-hidden="true"></span>
  </button>
</div>

<style>
  .frog-perch {
    position: absolute;
    right: 1.75rem;
    top: 0;
    transform: translateY(-100%);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .frog-button {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    line-height: 0;
  }
  /* One 64px frame of the 2x2 sheet; the animation walks the four frames. */
  .aldo-sprite {
    display: block;
    width: 64px;
    height: 64px;
    background-image: url("/pocketwild/aldo-sheet.png");
    background-size: 128px 128px;
    background-position: 0 0;
    image-rendering: pixelated;
  }
  @media (prefers-reduced-motion: no-preference) {
    .aldo-sprite {
      animation: aldo-bob 1.8s steps(1) infinite;
    }
    .frog-button.hop {
      animation: frog-hop 0.45s cubic-bezier(0.3, 0.8, 0.3, 1);
    }
  }
  @keyframes aldo-bob {
    0% {
      background-position: 0 0;
    }
    25% {
      background-position: -64px 0;
    }
    50% {
      background-position: 0 -64px;
    }
    75% {
      background-position: -64px -64px;
    }
  }
  @keyframes frog-hop {
    0% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-9px) scaleY(1.05);
    }
    70% {
      transform: translateY(0) scaleY(0.9);
    }
    100% {
      transform: translateY(0) scaleY(1);
    }
  }
  .frog-bubble {
    margin: 0 0 0.35rem;
    max-width: 15rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.4;
    color: var(--color-ink);
    background: var(--color-surface);
    border: 1px solid var(--color-faint);
    border-radius: 6px 6px 2px 6px;
    padding: 0.4rem 0.6rem;
    box-shadow: 0 1px 2px rgb(27 26 23 / 0.06);
  }
</style>

<script>
  const NOTES = [
    "ribbit.",
    "I narrate PocketWild.",
    "Every capture gets a name.",
    "Sun on everything today.",
    "Go outside. Log what you find.",
  ];
  const button = document.getElementById("frog-button");
  const bubble = document.getElementById("frog-bubble");
  let i = 0;
  let hideTimer: ReturnType<typeof setTimeout> | undefined;

  button?.addEventListener("click", () => {
    if (!bubble) return;
    bubble.textContent = NOTES[i % NOTES.length];
    bubble.hidden = false;
    i += 1;
    button.classList.remove("hop");
    void (button as HTMLElement).offsetWidth;
    button.classList.add("hop");
    clearTimeout(hideTimer);
    hideTimer = setTimeout(() => {
      bubble.hidden = true;
    }, 4200);
  });
</script>

---
// Nav is deliberately two doors: the wall of stickers (home) and the map that
// connects them. Collection, Writing, About, and Contact are commented out
// while the site is rethought as a pure exhibit space; their page files sit
// underscore-prefixed in src/pages/ and their URLs 301 home.
const nav = [{ href: "/map/", label: "Map", match: ["/map/"] }];

const path = Astro.url.pathname;
const isActive = (item: (typeof nav)[number]) => item.match.some((m) => path.startsWith(m));
---

<header class="border-b border-faint">
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-5">
    <a
      href="/"
      class="wonk text-lg font-semibold tracking-tight transition-colors hover:text-accent"
      style="view-transition-name: wordmark"
    >
      Jake Herridge
    </a>
    <nav aria-label="Primary" class="flex gap-x-5 text-sm">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item) ? "page" : undefined}
            class:list={[
              "transition-colors hover:text-accent",
              isActive(item) ? "text-accent" : "text-muted",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

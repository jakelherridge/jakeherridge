---
// The satchel's ink drawings: Jake's real pen sketches, scanned from grid
// paper and separated into transparent PNGs by scripts/sword-ink-build.mjs.
// These replaced the hand-rolled SVG paths on 2026-07-30; the turbulence
// wobble filter went with them, because real ink wobbles on its own.
import { Image } from "astro:assets";
import sword from "../assets/sword-ink/sword.png";
import stick from "../assets/sword-ink/stick.png";
import fish from "../assets/sword-ink/fish.png";
import egg from "../assets/sword-ink/egg.png";
import wood from "../assets/sword-ink/wood.png";
import fire from "../assets/sword-ink/fire.png";

interface Props {
  name: "sword" | "egg" | "stick" | "fish" | "wood" | "fire";
  size?: number;
}
const { name, size = 46 } = Astro.props;

const art = { sword, stick, fish, egg, wood, fire }[name];
---

<span class="ink-art" style={`--s:${size}px`}>
  <Image src={art} alt="" width={size * 3} format="png" />
</span>

<style>
  .ink-art {
    display: inline-grid;
    place-items: center;
    width: var(--s);
    height: var(--s);
  }
  .ink-art :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
  }
</style>

---
// Ink sketches for the satchel. Plain paths run through a small turbulence
// displacement so the strokes waver like a pen line instead of reading as
// clip art. One shared filter, drawn once per page.
interface Props {
  name: "sword" | "egg" | "stick" | "fish" | "wood" | "fire";
  size?: number;
}
const { name, size = 46 } = Astro.props;
---

<svg
  class="ink"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <g filter="url(#ink-wobble)">
    {
      name === "sword" && (
        <>
          <path d="M40 8 L44 12 L22 46 L16 48 L18 42 Z" />
          <path d="M14 44 L20 50" />
          <path d="M17 51 L13 55" />
          <path d="M11 49 L15 53" />
          <path d="M9 55 L13 51" opacity="0.5" />
        </>
      )
    }
    {
      name === "egg" && (
        <>
          <path d="M16 40c-5-3-3-11 3-13 2-7 11-9 16-5 6-2 12 3 11 9 4 3 3 10-3 11-6 4-22 3-27-2Z" />
          <circle cx="30" cy="33" r="6.5" />
        </>
      )
    }
    {
      name === "stick" && (
        <>
          <path d="M12 52C22 44 32 32 40 20" />
          <path d="M40 20 L46 14" />
          <path d="M40 20 L44 24" />
          <path d="M30 33 L36 31" />
          <path d="M22 42 L18 39" />
        </>
      )
    }
    {
      name === "fish" && (
        <>
          <path d="M10 32c8-11 26-13 36-3 3 3 5 3 5 3s-2 0-5 3c-10 10-28 8-36-3Z" />
          <path d="M51 32 L60 25 L58 32 L60 39 Z" />
          <circle cx="20" cy="30" r="1.6" fill="currentColor" />
          <path d="M28 24c3 4 3 12 0 16" opacity="0.6" />
        </>
      )
    }
    {
      name === "wood" && (
        <>
          <path d="M8 40 L44 30" />
          <path d="M10 47 L46 37" />
          <ellipse cx="45" cy="30.5" rx="3.5" ry="5" transform="rotate(-15 45 30.5)" />
          <ellipse cx="47" cy="37.5" rx="3.5" ry="5" transform="rotate(-15 47 37.5)" />
          <path d="M8 40 L10 47" />
          <path d="M18 22 L26 44" opacity="0.55" />
        </>
      )
    }
    {
      name === "fire" && (
        <>
          <path d="M32 12c6 8 2 12 5 16 2-2 3-5 3-5 4 6 6 10 6 15 0 8-7 14-14 14s-14-6-14-14c0-9 10-14 14-26Z" />
          <path d="M32 34c2 4 0 6 1 8 1-1 2-3 2-3 2 3 3 5 3 7 0 3-3 6-6 6s-6-3-6-6c0-4 4-7 6-12Z" opacity="0.6" />
        </>
      )
    }
  </g>
</svg>

<style is:global>
  .ink {
    display: block;
    overflow: visible;
  }
</style>
